# Configuration du déploiement — copier en deploy.config.env (ignoré par Git) :
#   cp deploy.config.env.example deploy.config.env
# Aucun mot de passe ici : l'accès SSH se fait par clé (ssh-copy-id).

DOMAIN=jlescoat.glsc.fr
SSH_HOST=            # IP ou alias ~/.ssh/config du VPS
SSH_USER=            # utilisateur non-root avec sudo
SSH_PORT=22
REMOTE_ROOT=/var/www/jlescoat.glsc.fr
CERTBOT_EMAIL=       # adresse qui recevra les avis d'expiration Let's Encrypt
KEEP_RELEASES=5
